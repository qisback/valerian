@VERSION@ and @DATE@ are filled in by packaging/linux/stage-fhs.sh.
-->
<component type="desktop-application">
  <id>casa.discworld.valerian</id>
  <name>Valerian</name>
  <summary>Deep-sky image processing for every computer</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="casa.discworld">
    <name>Laurence Horrocks-Barlow</name>
  </developer>
  <description>
    <p>
      Valerian takes the subframes you capture of galaxies, nebulae and clusters
      and turns them into a finished image: calibration, star registration,
      stacking with outlier rejection, gradient removal, colour calibration and
      stretching.
    </p>
    <p>
      The desktop app opens a FITS image and stretches it; the rest of the
      processing engine is available from the command line (valerian).
    </p>
    <p>
      Valerian is dedicated to the author's son Xaviar, whose middle name is
      Valerian.
    </p>
  </description>
  <launchable type="desktop-id">valerian.desktop</launchable>
  <provides>
    <binary>valerian</binary>
    <binary>valerian-gui</binary>
    <mediatype>image/fits</mediatype>
  </provides>
  <categories>
    <category>Science</category>
    <category>Astronomy</category>
  </categories>
  <keywords>
    <keyword>deep sky</keyword>
    <keyword>astrophotography</keyword>
    <keyword>stacking</keyword>
    <keyword>calibration</keyword>
  </keywords>
  <url type="homepage">https://github.com/qisback/valerian</url>
  <url type="bugtracker">https://github.com/qisback/valerian/issues</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
