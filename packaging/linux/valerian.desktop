[Desktop Entry]
Type=Application
Name=Valerian
GenericName=Deep-sky image processing
Comment=Process deep-sky astrophotography: calibrate, register, stack and stretch
Exec=valerian-gui %F
Icon=valerian
Terminal=false
Categories=Science;Astronomy;
Keywords=deep sky;astrophotography;stacking;calibration;nebula;galaxy;
MimeType=image/fits;
StartupWMClass=valerian
StartupNotify=true
