# Packs an already staged tree (packaging/linux/stage-fhs.sh); nothing is built
# here. @VERSION@ is the RPM version (a pre-release suffix becomes ~).

%global debug_package %{nil}
%global __os_install_post %{nil}
%global _build_id_links none

Name:           valerian
Version:        @VERSION@
Release:        1
Summary:        Deep-sky image processing
License:        GPL-3.0-or-later
URL:            https://github.com/qisback/valerian
Recommends:     vulkan-loader
Recommends:     mesa-vulkan-drivers

%description
Valerian turns the subframes you capture of galaxies, nebulae and clusters into a
finished image: calibration, registration, stacking, gradient removal, colour
calibration and stretching. This package has the desktop app (valerian-gui) and
the command line tool (valerian).

Valerian is dedicated to the author's son Xaviar, whose middle name is Valerian.

%install
mkdir -p %{buildroot}
cp -a %{stage}/. %{buildroot}/

%files
%{_bindir}/valerian
%{_bindir}/valerian-gui
%{_datadir}/applications/valerian.desktop
%{_datadir}/valerian/gaia-dr3-g11.vcat
%{_datadir}/icons/hicolor/*/apps/valerian.png
%{_datadir}/metainfo/casa.discworld.valerian.metainfo.xml
%doc %{_docdir}/valerian
%license %{_docdir}/valerian/LICENSE
%license %{_docdir}/valerian/ADDITIONAL-TERMS.md
%license %{_docdir}/valerian/LOGO-LICENCE.md
%license %{_docdir}/valerian/CC-BY-NC-3.0-IGO.txt

%changelog
* Tue Oct 20 2026 Laurence Horrocks-Barlow <9962027+qisback@users.noreply.github.com> - @VERSION@-1
- See /usr/share/doc/valerian/changelog.gz
